# Template only — do not commit real values.
#
# Copy to /etc/mcpvault-web/env on the host, mode 0600, owned by the user
# that runs the rootless Podman unit (same rule as the deploy webhook's
# secret, .plans/shibumi-website-migration.md "Deploy webhook"):
#   install -m 600 -o <user> -g <user> env.example /etc/mcpvault-web/env
#   # then edit /etc/mcpvault-web/env with real values
#
# The container image never bakes these in; server.ts reads them from the
# process environment at startup only.

RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# PORT=3000
# HOST=0.0.0.0
# SHUTDOWN_DRAIN_TIMEOUT_MS=10000
