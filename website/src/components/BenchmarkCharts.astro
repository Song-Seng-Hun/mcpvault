---
// Benchmark bars rendered at build time. No client framework, no chart
// library: plain markup, CSS entrance animation, native tooltips.
//
// Measured 2026-08-17 on macOS (Darwin 25.6), Node v26.7.0, against a real
// vault (381 notes, 84 folders, 3.2 MB) over stdio in read-only mode.
// Scripts: benchmarks/bench-v1-client.mjs and bench-v2-client.mjs in the repo.
type Stat = { median: number; p95: number; n: number };
type Pairing = {
  name: string;
  short: string;
  detail: string;
  coldStart: Stat;
  tools: Record<string, Stat>;
};

const PAIRINGS: Pairing[] = [
  {
    name: 'MCPVault today',
    short: 'today',
    detail: 'the current npm release, measured as a baseline',
    coldStart: { median: 107.3, p95: 155.5, n: 8 },
    tools: {
      'tools/list': { median: 0.15, p95: 0.28, n: 50 },
      get_vault_stats: { median: 12.13, p95: 13.95, n: 50 },
      read_note: { median: 0.46, p95: 0.84, n: 50 },
      list_directory: { median: 0.45, p95: 0.66, n: 50 },
      search_notes: { median: 85.53, p95: 107.44, n: 20 },
    },
  },
  {
    name: 'MCP v2 with today’s apps',
    short: 'MCP v2, today’s apps',
    detail: 'the MCP v2 build answering the apps you already use, unchanged (Claude Desktop, Cursor, and friends)',
    coldStart: { median: 109.8, p95: 116.8, n: 8 },
    tools: {
      'tools/list': { median: 0.14, p95: 0.28, n: 50 },
      get_vault_stats: { median: 11.4, p95: 12.2, n: 50 },
      read_note: { median: 0.43, p95: 0.58, n: 50 },
      list_directory: { median: 0.43, p95: 0.49, n: 50 },
      search_notes: { median: 84.33, p95: 86.4, n: 20 },
    },
  },
  {
    name: 'MCP v2 with new apps',
    short: 'MCP v2, new apps',
    detail: 'the MCP v2 build with an app on the new SDK (2.0.0), how connections will look as the ecosystem updates',
    coldStart: { median: 105.8, p95: 107.8, n: 8 },
    tools: {
      'tools/list': { median: 0.17, p95: 0.34, n: 50 },
      get_vault_stats: { median: 11.66, p95: 12.33, n: 50 },
      read_note: { median: 0.45, p95: 0.65, n: 50 },
      list_directory: { median: 0.46, p95: 0.64, n: 50 },
      search_notes: { median: 85.62, p95: 88.15, n: 20 },
    },
  },
];

// Validated for CVD separation and 3:1 contrast on the #171717 card surface.
const COLORS = ['#0891b2', '#8b5cf6', '#d97706'];
const TOOLS = Object.keys(PAIRINGS[0].tools);

type ChartRow = { short: string; name: string; color: string; stat: Stat; widthPct: number };
type ChartSpec = { title: string; unit: string; axisMax: number; rows: ChartRow[] };

// Round an axis limit up to a clean 1/1.5/2/2.5/5/10 step, e.g. 109.8 -> 120.
function niceCeil(v: number): number {
  const mag = 10 ** Math.floor(Math.log10(v));
  for (const step of [1, 1.2, 1.5, 2, 2.5, 5, 10]) {
    if (v <= step * mag) return step * mag;
  }
  return 10 * mag;
}

function buildChart(title: string, unit: string, stats: Stat[]): ChartSpec {
  const axisMax = niceCeil(Math.max(...stats.map((s) => s.median)) * 1.02);
  return {
    title,
    unit,
    axisMax,
    rows: stats.map((stat, i) => ({
      short: PAIRINGS[i].short,
      name: PAIRINGS[i].name,
      color: COLORS[i],
      stat,
      widthPct: (stat.median / axisMax) * 100,
    })),
  };
}

const coldChart = buildChart('Cold start', 'spawn to first response, median ms, lower is better', PAIRINGS.map((p) => p.coldStart));
const toolCharts = TOOLS.map((tool) => buildChart(tool, 'median ms', PAIRINGS.map((p) => p.tools[tool])));

const fmt = (v: number) => (v >= 10 ? v.toFixed(1) : v.toFixed(2));
---

<div class="space-y-8">
  <figure class="bench-card rounded-xl border border-border/50 bg-card/40 p-4 backdrop-blur-md sm:p-5">
    <figcaption class="mb-3 text-sm font-semibold text-foreground">
      {coldChart.title} <span class="font-normal text-muted-foreground">· {coldChart.unit}</span>
    </figcaption>
    {coldChart.rows.map((row, i) => (
      <div class="mb-2 grid grid-cols-[9.5rem_1fr_3.5rem] items-center gap-3 last:mb-0">
        <span class="text-right text-xs text-muted-foreground">{row.short}</span>
        <div
          class="bench-track relative h-5"
          title={`${row.name}: median ${fmt(row.stat.median)} ms, p95 ${fmt(row.stat.p95)} ms, n=${row.stat.n}`}
        >
          <div
            class="bench-bar absolute top-0.5 h-4 rounded-r"
            style={`width:${row.widthPct}%;background:${row.color};animation-delay:${i * 80}ms`}
          >
          </div>
        </div>
        <span class="text-right text-xs tabular-nums text-muted-foreground">{fmt(row.stat.median)}</span>
      </div>
    ))}
    <div class="mt-2 flex justify-between border-t border-border pt-1 text-[11px] tabular-nums text-muted-foreground/70">
      <span>0</span><span>{coldChart.axisMax} ms</span>
    </div>
  </figure>

  <div>
    <h3 class="mb-3 text-[1.2rem] font-semibold text-foreground">
      Per request, warm connection <span class="font-normal text-muted-foreground">· median ms</span>
    </h3>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {toolCharts.map((chart) => (
        <figure class="bench-card rounded-xl border border-border/50 bg-card/40 p-4 backdrop-blur-md">
          <figcaption class="mb-3 text-sm font-semibold text-foreground">{chart.title}</figcaption>
          {chart.rows.map((row, i) => (
            <div class="mb-2 grid grid-cols-[8.5rem_1fr] items-center gap-2 last:mb-0">
              <span class="text-right text-[11px] text-muted-foreground">{row.short}</span>
              <div
                class="bench-track relative h-5"
                title={`${row.name}: median ${fmt(row.stat.median)} ms, p95 ${fmt(row.stat.p95)} ms, n=${row.stat.n}`}
              >
                <div
                  class="bench-bar absolute top-0.5 h-4 rounded-r"
                  style={`width:${row.widthPct}%;background:${row.color};animation-delay:${i * 80}ms`}
                >
                </div>
              </div>
            </div>
          ))}
          <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 border-t border-border pt-2 text-[11px] text-muted-foreground">
            {chart.rows.map((row) => (
              <span class="flex items-center gap-1">
                <span class="inline-block h-2 w-2 rounded-sm" style={`background:${row.color}`} aria-hidden="true"></span>
                <span class="tabular-nums text-foreground">{fmt(row.stat.median)}</span>
              </span>
            ))}
            <span class="ml-auto">ms</span>
          </div>
        </figure>
      ))}
    </div>
  </div>

  <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
    {PAIRINGS.map((p, i) => (
      <span class="flex items-start gap-2">
        <span class="mt-[0.3rem] inline-block h-2.5 w-2.5 flex-shrink-0 rounded-sm" style={`background:${COLORS[i]}`} aria-hidden="true"></span>
        <span><strong class="font-semibold text-foreground">{p.name}</strong>: {p.detail}</span>
      </span>
    ))}
  </div>

  <details class="rounded-xl border border-border/50 bg-card/40 px-4 py-3 backdrop-blur-md">
    <summary class="cursor-pointer text-sm font-semibold text-foreground">Full numbers (median and p95, in ms)</summary>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full min-w-[540px] text-left text-sm">
        <thead>
          <tr class="border-b border-border text-xs uppercase tracking-wide text-muted-foreground">
            <th class="py-2 pr-4 font-semibold">metric</th>
            {PAIRINGS.map((p) => <th class="py-2 pr-4 font-semibold">{p.name}</th>)}
          </tr>
        </thead>
        <tbody class="tabular-nums text-muted-foreground">
          <tr class="border-b border-border/60">
            <td class="py-2 pr-4 text-foreground">cold start (n=8)</td>
            {PAIRINGS.map((p) => (
              <td class="py-2 pr-4">{p.coldStart.median} · p95 {p.coldStart.p95}</td>
            ))}
          </tr>
          {TOOLS.map((tool) => (
            <tr class="border-b border-border/60 last:border-b-0">
              <td class="py-2 pr-4 text-foreground">{tool} (n={PAIRINGS[0].tools[tool].n})</td>
              {PAIRINGS.map((p) => (
                <td class="py-2 pr-4">{p.tools[tool].median} · p95 {p.tools[tool].p95}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>

<style>
  .bench-track {
    background: rgba(148, 163, 184, 0.07);
    border-radius: 0 0.25rem 0.25rem 0;
  }
  .bench-bar {
    transform-origin: left center;
    transform: scaleX(0);
  }
  .bench-card.in-view .bench-bar {
    animation: bench-grow 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes bench-grow {
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bench-bar {
      transform: none;
    }
    .bench-card.in-view .bench-bar {
      animation: none;
    }
  }
</style>

<script>
  // Grow bars when their card scrolls into view; runs again after
  // Astro view transitions.
  function watchBenchCards() {
    const cards = document.querySelectorAll('.bench-card');
    if (!cards.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.3 },
    );
    cards.forEach((c) => io.observe(c));
  }
  watchBenchCards();
  document.addEventListener('astro:page-load', watchBenchCards);
</script>
