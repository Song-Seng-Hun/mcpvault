---
import { ArrowRight, GitBranch } from 'lucide-react';

const specUrl = 'https://modelcontextprotocol.io/specification/latest';
---

<section class="spec-preview relative px-4 pb-4 sm:px-6 lg:px-8" aria-label="Latest MCP specification development preview">
  <div class="relative mx-auto max-w-4xl">
    <div id="spec-confetti" class="pointer-events-none absolute inset-0 z-20" aria-hidden="true"></div>
    <div class="spec-preview-card relative overflow-hidden rounded-xl border border-border/60 bg-card/70 px-5 py-4">
      <div class="relative z-10 flex items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-3">
          <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border border-accent/30 bg-accent/15">
            <GitBranch className="h-4 w-4 text-accent" aria-hidden="true" />
          </div>

          <p class="text-sm leading-relaxed text-muted-foreground">
            <span class="font-semibold text-foreground">
              The <a href={specUrl} target="_blank" rel="noopener noreferrer" class="spec-link">latest MCP spec</a> is out.
            </span>
            <span class="sm:hidden"> We’re getting ready for it.</span>
            <span class="hidden sm:inline"> We’re getting MCPVault ready for it.</span>
          </p>
        </div>

        <a
          href="/benchmarks"
          aria-label="See the MCP v2 benchmarks"
          class="work-link inline-flex h-10 w-10 flex-shrink-0 items-center justify-center gap-2 rounded-lg border border-accent/25 bg-accent/10 text-sm font-semibold text-accent transition-colors hover:border-accent/45 hover:bg-accent/20 sm:w-auto sm:px-3"
        >
          <span class="hidden sm:inline">See the benchmarks</span>
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .spec-preview-card::after {
    content: '';
    position: absolute;
    inset: -8rem -2rem auto auto;
    width: 16rem;
    height: 16rem;
    background: radial-gradient(circle, rgba(144, 101, 234, 0.22), transparent 62%);
    pointer-events: none;
  }

  .spec-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(144, 101, 234, 0.45);
    text-underline-offset: 0.2em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .spec-link:hover,
  .work-link:hover {
    color: #cba6f7;
  }

  .spec-link:hover {
    text-decoration-color: currentColor;
  }

  .spec-link:focus-visible,
  .work-link:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid rgba(144, 101, 234, 0.75);
    outline-offset: 3px;
  }

</style>

<script>
  // One confetti burst over the spec banner per visit to this page.
  function specConfetti() {
    const layer = document.getElementById('spec-confetti');
    if (!layer || layer.dataset.done) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    layer.dataset.done = '1';

    const colors = ['#8b5cf6', '#06b6d4', '#d97706', '#22c55e', '#fafafa'];
    for (let i = 0; i < 48; i++) {
      const piece = document.createElement('span');
      const size = 4 + Math.random() * 5;
      piece.style.cssText = [
        'position:absolute',
        'top:50%',
        'left:50%',
        `width:${size}px`,
        `height:${size * 0.55}px`,
        `background:${colors[i % colors.length]}`,
        'border-radius:1px',
      ].join(';');
      layer.appendChild(piece);

      // Radial explosion from the banner center, quick decay with a hint of gravity.
      const angle = Math.random() * Math.PI * 2;
      const distance = 90 + Math.random() * 210;
      const dx = Math.cos(angle) * distance;
      const dy = Math.sin(angle) * distance;
      const spin = (Math.random() - 0.5) * 720;
      piece
        .animate(
          [
            { transform: 'translate(0,0) rotate(0deg)', opacity: 1 },
            { transform: `translate(${dx}px,${dy}px) rotate(${spin * 0.7}deg)`, opacity: 1, offset: 0.55 },
            { transform: `translate(${dx * 1.15}px,${dy * 1.15 + 40}px) rotate(${spin}deg)`, opacity: 0 },
          ],
          {
            duration: 650 + Math.random() * 350,
            easing: 'cubic-bezier(0.1, 0.7, 0.3, 1)',
            fill: 'forwards',
          },
        )
        .finished.then(() => piece.remove())
        .catch(() => piece.remove());
    }
  }

  specConfetti();
  document.addEventListener('astro:page-load', specConfetti);
</script>
